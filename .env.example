# Job_Applying_Cron — example environment file.
# Copy this to .env and fill in your own values:   cp .env.example .env
# .env is git-ignored and must never be committed.

# --- Telegram (used for run reports and for questions the run cannot answer) ---
# Create a bot with @BotFather, then message it once and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=000000000

# --- Browser ---
# The engine attaches to your ALREADY-RUNNING Chromium browser over the Chrome
# DevTools Protocol. Start it with:  --remote-debugging-port=9222
BRAVE_CDP_PORT=9222

# --- Models (preference order, comma-separated) ---
# Free model ids end in ":free" or "-free" and cost nothing; paid ids have no suffix.
# The launcher tries them in order and escalates to the paid model when a free one
# fails or records nothing (subject to the quota gate).
APPLY_MODELS=poolside/laguna-s-2.1-free,deepseek/deepseek-v4-flash

# --- Run budget ---
# Total wall-clock budget for one run (seconds) and the per-model slice.
APPLY_TIMEOUT_SECONDS=1320
APPLY_PER_MODEL_SECONDS=900
# Short leash for the first (free) model so a throttled free model cannot eat the run.
APPLY_FIRST_MODEL_SECONDS=240
# Max agent turns per model attempt.
APPLY_MAX_TURNS=140
# Seconds to wait for another channel's run to release the browser before starting.
JOB_APPLY_LOCK_WAIT_SECONDS=1500

# --- Efficiency / budget governor ---
# End a run once this many applications are confirmed.
APPLY_RUN_TARGET=10
# Max unpaid "skips" a channel may carry over (0-skipped compensation ledger).
APPLY_DEBT_CAP=20
# Seconds held back so a paid model always gets one usable attempt.
APPLY_PAID_RESERVE_SECONDS=420
# When a quota window reaches this % used, drop the paid model and go free-only.
APPLY_5H_STOP_PCT=90
APPLY_WEEKLY_STOP_PCT=95
APPLY_MONTHLY_STOP_PCT=98
