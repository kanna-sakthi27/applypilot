#!/usr/bin/env node
// cc-quota — Command Code quota checker + automation gate
// Usage:
//   cc-quota                 human-readable table (5h / weekly / monthly windows)
//   cc-quota --json          machine-readable JSON
//   cc-quota --gate          exit 0 = OK to run, exit 3 = blocked (prints JSON reason)
//   env CC_GATE_WEEKLY_PCT=95  block when weekly window usage >= 95% of cap (default)
//   env CC_GATE_MONTHLY_PCT=100 block when monthly usage >= 100% of plan credits
//   env CC_TIMEOUT_MS=15000
// API key is read from ~/.commandcode/auth.json (Command Code CLI login),
// then ~/.openclaw/openclaw.json, or $COMMANDCODE_API_KEY. Never printed.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';

const API = 'https://api.commandcode.ai';
const PLAN_MONTHLY = {
  'individual-go': 10,
  'individual-goat': 70,
  'individual-pro': 80,
  'individual-max-10x': 150,
  'individual-max-20x': 300,
  'team-pro': 40,
};

function readKey() {
  if (process.env.COMMANDCODE_API_KEY) return process.env.COMMANDCODE_API_KEY;
  // Command Code CLI owns the credential now.
  try {
    const cc = JSON.parse(fs.readFileSync(path.join(os.homedir(), '.commandcode', 'auth.json'), 'utf8'));
    if (typeof cc?.apiKey === 'string' && cc.apiKey.startsWith('user_')) return cc.apiKey;
  } catch {}
  try {
    const cfgPath = path.join(os.homedir(), '.openclaw', 'openclaw.json');
    const cfg = JSON.parse(fs.readFileSync(cfgPath, 'utf8'));
    const k = cfg?.models?.providers?.commandcode?.apiKey;
    if (typeof k === 'string' && k.startsWith('user_')) return k;
  } catch {}
  return null;
}

async function getJson(key, endpoint, timeoutMs) {
  const r = await fetch(API + endpoint, {
    headers: { Authorization: 'Bearer ' + key, Accept: 'application/json' },
    signal: AbortSignal.timeout(timeoutMs),
  });
  if (!r.ok) throw new Error(`${endpoint} -> HTTP ${r.status}`);
  return r.json();
}

const fmt$ = (n) => '$' + Number(n).toFixed(2);

function fmtReset(ms) {
  if (!ms) return '-';
  const d = new Date(ms);
  const mins = Math.round((ms - Date.now()) / 60000);
  const inStr = mins < 60 ? `in ${Math.max(mins, 0)}m`
    : mins < 60 * 24 * 7 ? `in ${Math.round(mins / 60)}h`
    : `in ${Math.round(mins / 1440)}d`;
  return new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Kuala_Lumpur', month: 'short', day: 'numeric',
    hour: '2-digit', minute: '2-digit',
  }).format(d) + ' MYT (' + inStr + ')';
}

async function main() {
  const args = process.argv.slice(2);
  const jsonMode = args.includes('--json');
  const gateMode = args.includes('--gate');
  const timeoutMs = Number(process.env.CC_TIMEOUT_MS) || 15000;
  const weeklyPct = Number(process.env.CC_GATE_WEEKLY_PCT) || 95;
  const monthlyPct = Number(process.env.CC_GATE_MONTHLY_PCT) || 100;

  const key = readKey();
  const out = (o) => console.log(JSON.stringify(o));

  if (!key) {
    if (gateMode) return out({ decision: 'allow', reason: 'no API key found; gate fails open' }), 0;
    console.error('cc-quota: no Command Code API key (openclaw.json or $COMMANDCODE_API_KEY)');
    process.exit(2);
  }

  let credits, subs, user;
  try {
    [credits, subs, user] = await Promise.all([
      getJson(key, '/alpha/billing/credits', timeoutMs),
      getJson(key, '/alpha/billing/subscriptions', timeoutMs).catch(() => null),
      getJson(key, '/alpha/whoami', timeoutMs).catch(() => null),
    ]);
  } catch (e) {
    if (gateMode) { out({ decision: 'allow', reason: `quota API unreachable (${e.message}); gate fails open` }); process.exit(0); }
    console.error('cc-quota: quota API unreachable:', e.message);
    process.exit(2);
  }

  const planId = subs?.data?.planId ?? subs?.planId ?? null;
  const monthlyCap = PLAN_MONTHLY[planId] ?? (planId ? null : 70);
  const wl = credits.windowLimits || {};
  const five = wl.fiveHour || {};
  const week = wl.weekly || {};
  const monthlyUsed = credits.credits?.monthlyCredits ?? null;

  const data = {
    account: user?.user?.email ?? null,
    plan: planId,
    asOf: new Date().toISOString(),
    five_hour: { used: five.used ?? null, cap: five.cap ?? null, resetAt: five.resetAt ?? null },
    weekly: { used: week.used ?? null, cap: week.cap ?? null, resetAt: week.resetAt ?? null },
    monthly: { used: monthlyUsed, cap: monthlyCap, resetAt: subs?.data?.currentPeriodEnd ? Date.parse(subs.data.currentPeriodEnd) : null },
    purchased_credits: credits.credits?.purchasedCredits ?? 0,
    free_credits: credits.credits?.freeCredits ?? 0,
  };

  // Gate decision (weekly + monthly only; the 5h window is a burst guard and
  // free-model runs don't draw from credits at all).
  let decision = 'allow';
  let reason = 'quota healthy';
  const near = (u, c) => u != null && c ? (u / c) * 100 : null;
  if (data.weekly.cap && near(data.weekly.used, data.weekly.cap) >= weeklyPct) {
    decision = 'block';
    reason = `weekly window >=${weeklyPct}% used (${fmt$(data.weekly.used)}/${fmt$(data.weekly.cap)}), resets ${fmtReset(data.weekly.resetAt)}`;
  } else if (data.monthly.cap && data.monthly.used != null &&
      (data.monthly.used / data.monthly.cap) * 100 >= monthlyPct) {
    decision = 'block';
    reason = `monthly credits >=${monthlyPct}% used (${fmt$(data.monthly.used)}/${fmt$(data.monthly.cap)})`;
  }
  data.decision = decision;
  data.reason = reason;
  data.gate = { weekly_pct_threshold: weeklyPct, monthly_pct_threshold: monthlyPct };

  if (gateMode) {
    try {
      const logDir = path.join(path.dirname(new URL(import.meta.url).pathname), '..', 'logs');
      fs.mkdirSync(logDir, { recursive: true });
      fs.appendFileSync(path.join(logDir, 'cc-quota-gate.jsonl'),
        JSON.stringify({ at: data.asOf, job: process.env.CC_GATE_JOB || null, ...data }) + '\n');
    } catch {}
    out(data);
    process.exit(decision === 'block' ? 3 : 0);
  }
  if (jsonMode) { out(data); return; }

  const left = (u, c) => (u == null || !c) ? '-' : fmt$(c - u);
  const row = (name, w) => {
    const pct = (w.used != null && w.cap) ? `${Math.round((w.used / w.cap) * 100)}%` : '-';
    console.log(
      name.padEnd(10),
      ('used ' + (w.used == null ? '-' : fmt$(w.used)) + ' / ' + (w.cap ? fmt$(w.cap) : '?')).padEnd(24),
      ('left ' + left(w.used, w.cap)).padEnd(14),
      pct.padEnd(6),
      fmtReset(w.resetAt),
    );
  };
  console.log(`Command Code · ${planId || 'plan?'} · ${data.account || ''}`);
  row('5-hour', data.five_hour);
  row('weekly', data.weekly);
  row('monthly', data.monthly);
  console.log(`purchased ${fmt$(data.purchased_credits)} · free ${fmt$(data.free_credits)} · gate: ${decision} (${reason})`);
}

main().catch((e) => { console.error('cc-quota error:', e.message); process.exit(2); });
